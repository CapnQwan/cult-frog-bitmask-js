{
  "name": "@cult-frog/bitmask",
  "version": "0.0.0",
  "description": "A lightweight TypeScript library of bitmask operations and utilities for managing bitwise flags",
  "license": "MIT",
  "author": "Quin Partridge",
  "keywords": [
    "bitmask",
    "bitwise",
    "flags",
    "gamedev",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapnQwan/cult-frog-bitmask-js.git"
  },
  "bugs": {
    "url": "https://github.com/CapnQwan/cult-frog-bitmask-js/issues"
  },
  "homepage": "https://github.com/CapnQwan/cult-frog-bitmask-js#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "biome check . --error-on-warnings",
    "check:ci": "biome ci . --error-on-warnings",
    "fix": "biome check . --write",
    "prepublishOnly": "pnpm check:ci && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.33.4",
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@cult-frog/tooling": "^0.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@cult-frog/types": "^1.0.1"
  }
}
